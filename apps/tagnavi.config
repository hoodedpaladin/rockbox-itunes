# Define the A to Z track sub menu
%menu_start "custom_track" "Track A to Z"
"Numeric"   -> title ? title < "A" ->  title = "fmt_title"
"A"   -> title ? title ^ "A" ->  title = "fmt_title"
"B"   -> title ? title ^ "B" ->  title = "fmt_title"
"C"   -> title ? title ^ "C" ->  title = "fmt_title"
